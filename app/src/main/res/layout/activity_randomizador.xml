<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/espaco_grande">

    <TextView
        style="@style/Texto.Titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/modulo_randomizador" />

    <TextView
        style="@style/Texto.Subtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/espaco_pequeno"
        android:text="@string/dica_remover" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilValor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/espaco_pequeno"
            android:layout_weight="1"
            android:hint="@string/hint_valor">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etValor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:maxLength="30"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <Spinner
            android:id="@+id/spCategoria"
            android:layout_width="140dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_card"
            android:popupBackground="@drawable/bg_card" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_pequeno"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdicionar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/espaco_pequeno"
            android:layout_weight="1"
            android:paddingHorizontal="8dp"
            android:text="@string/adicionar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSortear"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/espaco_pequeno"
            android:layout_weight="1"
            android:paddingHorizontal="8dp"
            android:text="@string/sortear" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlternar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:text="@string/alternar_lista"
            android:textColor="@color/neon_cyan" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSorteado"
        style="@style/Texto.Subtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_pequeno"
        android:background="@drawable/bg_card_destaque"
        android:gravity="center"
        android:padding="@dimen/espaco_medio"
        android:text="@string/sorteado_vazio"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvItens"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/espaco_pequeno"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:minHeight="120dp" />

    <include
        android:id="@+id/navegacao"
        layout="@layout/include_navegacao" />

</LinearLayout>
