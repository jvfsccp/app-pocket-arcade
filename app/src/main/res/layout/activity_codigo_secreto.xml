<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espaco_grande">

        <TextView
            style="@style/Texto.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/modulo_codigo" />

        <TextView
            style="@style/Texto.Subtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/espaco_medio"
            android:text="@string/codigo_instrucao" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTentativa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_tentativa">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTentativa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="4"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTentar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_medio"
            android:text="@string/tentar" />

        <TextView
            android:id="@+id/tvTentativas"
            style="@style/Texto.Corpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_medio"
            android:textColor="@color/neon_yellow" />

        <!-- Legenda das cores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/espaco_medio">

            <TextView
                style="@style/Texto.Corpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/espaco_pequeno"
                android:text="@string/legenda_verde"
                android:textColor="@color/clue_certo" />

            <TextView
                style="@style/Texto.Corpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/legenda_amarelo"
                android:textColor="@color/clue_posicao" />

            <TextView
                style="@style/Texto.Corpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/legenda_cinza"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Resultado da partida (mesma tela) -->
        <LinearLayout
            android:id="@+id/painelFinal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_medio"
            android:background="@drawable/bg_card_destaque"
            android:orientation="vertical"
            android:padding="@dimen/espaco_medio"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvResultadoFinal"
                style="@style/Texto.Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvEstatisticas"
                style="@style/Texto.Corpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:gravity="center"
                android:textColor="@color/text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNovaPartida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_medio"
                android:text="@string/nova_partida" />
        </LinearLayout>

        <TextView
            style="@style/Texto.Subtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:text="@string/historico_titulo" />

        <LinearLayout
            android:id="@+id/llHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <include
            android:id="@+id/navegacao"
            layout="@layout/include_navegacao" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
