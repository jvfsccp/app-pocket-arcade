<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/espaco_pequeno">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDigito1"
            android:layout_width="@dimen/tile_clue"
            android:layout_height="@dimen/tile_clue"
            android:layout_marginEnd="@dimen/espaco_pequeno"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDigito2"
            android:layout_width="@dimen/tile_clue"
            android:layout_height="@dimen/tile_clue"
            android:layout_marginEnd="@dimen/espaco_pequeno"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDigito3"
            android:layout_width="@dimen/tile_clue"
            android:layout_height="@dimen/tile_clue"
            android:layout_marginEnd="@dimen/espaco_pequeno"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDigito4"
            android:layout_width="@dimen/tile_clue"
            android:layout_height="@dimen/tile_clue"
            android:layout_marginEnd="@dimen/espaco_medio"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvResumo"
            style="@style/Texto.Corpo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
