<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espaco_grande">

        <TextView
            style="@style/Texto.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/modulo_arena" />

        <TextView
            style="@style/Texto.Subtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/espaco_medio"
            android:text="@string/arena_instrucao" />

        <!-- Placar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:padding="@dimen/espaco_medio">

            <TextView
                style="@style/Texto.Corpo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/placar_jogador"
                android:textColor="@color/neon_cyan"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlacar"
                style="@style/Texto.Titulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/placar_formato" />

            <TextView
                style="@style/Texto.Corpo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/placar_dispositivo"
                android:textColor="@color/neon_pink"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Escolha do jogador -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPedra"
                android:layout_width="@dimen/botao_jogada"
                android:layout_height="@dimen/botao_jogada"
                android:layout_marginHorizontal="@dimen/espaco_pequeno"
                android:background="@drawable/bg_botao_jogada"
                android:contentDescription="@string/desc_pedra"
                android:padding="@dimen/espaco_medio"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pedra" />

            <ImageButton
                android:id="@+id/btnPapel"
                android:layout_width="@dimen/botao_jogada"
                android:layout_height="@dimen/botao_jogada"
                android:layout_marginHorizontal="@dimen/espaco_pequeno"
                android:background="@drawable/bg_botao_jogada"
                android:contentDescription="@string/desc_papel"
                android:padding="@dimen/espaco_medio"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_papel" />

            <ImageButton
                android:id="@+id/btnTesoura"
                android:layout_width="@dimen/botao_jogada"
                android:layout_height="@dimen/botao_jogada"
                android:layout_marginHorizontal="@dimen/espaco_pequeno"
                android:background="@drawable/bg_botao_jogada"
                android:contentDescription="@string/desc_tesoura"
                android:padding="@dimen/espaco_medio"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tesoura" />
        </LinearLayout>

        <!-- Jogador x dispositivo -->
        <LinearLayout
            android:id="@+id/painelRodada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/espaco_medio">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivEscolhaJogador"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/icone_escolha"
                    android:layout_weight="1"
                    android:contentDescription="@string/desc_escolha_jogador"
                    android:src="@drawable/ic_logo" />

                <TextView
                    style="@style/Texto.Titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vs"
                    android:textColor="@color/neon_yellow" />

                <ImageView
                    android:id="@+id/ivEscolhaDispositivo"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/icone_escolha"
                    android:layout_weight="1"
                    android:contentDescription="@string/desc_escolha_dispositivo"
                    android:src="@drawable/ic_logo" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvResultadoRodada"
                style="@style/Texto.Subtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_medio"
                android:gravity="center"
                android:text="@string/aguardando_jogada"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResultadoFinal"
                style="@style/Texto.Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:gravity="center"
                android:textColor="@color/neon_yellow"
                android:textSize="22sp"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNovaPartida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_medio"
            android:text="@string/nova_partida" />

        <include
            android:id="@+id/navegacao"
            layout="@layout/include_navegacao" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
