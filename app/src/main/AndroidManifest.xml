<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketArcade">

        <!-- Tela 1: apresentação (launcher). Recebe o retorno em onNewIntent(). -->
        <activity
            android:name=".ApresentacaoActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tela 2: Central de Desafios (menu rolável). -->
        <activity
            android:name=".CentralActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Tela 3: Scanner de Mensagens. -->
        <activity
            android:name=".ScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tela 4: Arena (Pedra, Papel e Tesoura). -->
        <activity
            android:name=".ArenaActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Tela 5: Cofre do Código Secreto. -->
        <activity
            android:name=".CodigoSecretoActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tela 6: Randomizador (RecyclerView). -->
        <activity
            android:name=".RandomizadorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
